<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity" >

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="1260dp"
        android:layout_height="1186dp"
        android:contentDescription="@string/imagemfecaplogo"
        app:srcCompat="@drawable/bg"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="-613dp"
        tools:layout_editor_absoluteY="-151dp" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="392dp"
        android:layout_height="186dp"
        android:contentDescription="@string/imagemfecaplogo"
        app:srcCompat="@drawable/logo_responsivo"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="22dp"
        tools:layout_editor_absoluteY="183dp" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bem_vindo_a_nosso_app"
        android:textColor="@color/green"
        android:textSize="20sp"
        tools:layout_editor_absoluteX="111dp"
        tools:layout_editor_absoluteY="142dp"
        tools:ignore="MissingConstraints" />

    <EditText
        android:id="@+id/editTextInput"
        android:layout_width="350dp"
        android:layout_height="40dp"
        android:autofillHints="Digite seu nome aqui!"
        android:background="@color/white"
        android:hint="Digite seu nome aqui!"
        android:inputType="text"
        android:textColorHint="@color/black"
        app:boxStrokeColor="@color/green"
        tools:ignore="HardcodedText,MissingConstraints"
        tools:layout_editor_absoluteX="43dp"
        tools:layout_editor_absoluteY="397dp" />

    <Button
        android:id="@+id/button4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/confirmar"
        android:backgroundTint="@color/green"
        android:shadowColor="@color/black"
        tools:layout_editor_absoluteX="157dp"
        tools:layout_editor_absoluteY="458dp"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>